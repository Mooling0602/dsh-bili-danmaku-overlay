{
  "name": "dsh-bili-danmaku-overlay",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Bilibili live danmaku as an always-visible overlay in the DSH Web UI.",
  "license": "MIT",
  "author": "Mooling0602",
  "icon": "icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mooling0602/dsh-bili-danmaku-overlay.git"
  },
  "bugs": {
    "url": "https://github.com/Mooling0602/dsh-bili-danmaku-overlay/issues"
  },
  "homepage": "https://github.com/Mooling0602/dsh-bili-danmaku-overlay#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "bilibili",
    "danmaku",
    "overlay"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.4",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.4",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.4",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
